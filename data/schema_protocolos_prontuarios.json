{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://exemplo.saude.br/schemas/prontuarios-protocolos.schema.json",
  "title": "SchemaIntegradoProtocolosEProntuarios",
  "description": "Schema JSON Draft-07 para validação de protocolos clínicos e prontuários eletrônicos integrados (padrões CID-10, TUSS, DCB e HL7-FHIR-BR).",
  "aviso_legal": "This is for informational purposes only. For medical advice or diagnosis, consult a professional. AI responses may include mistakes.",
  "type": "object",
  "required": [
    "metadata",
    "protocolos_clinicos",
    "prontuarios"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "versao_schema",
        "padrao_terminologia",
        "gerado_em",
        "unidade_origem"
      ],
      "properties": {
        "versao_schema": {
          "type": "string"
        },
        "padrao_terminologia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gerado_em": {
          "type": "string",
          "format": "date-time"
        },
        "unidade_origem": {
          "type": "object",
          "required": [
            "cnes",
            "nome",
            "municipio"
          ],
          "properties": {
            "cnes": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "municipio": {
              "type": "string"
            }
          }
        }
      }
    },
    "protocolos_clinicos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "protocolo_id",
          "titulo",
          "especialidade",
          "versao",
          "cid10_relacionados",
          "criterios_inclusao",
          "etapas",
          "prescricao_padrao"
        ],
        "properties": {
          "protocolo_id": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "especialidade": {
            "type": "string"
          },
          "versao": {
            "type": "string"
          },
          "cid10_relacionados": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criterios_inclusao": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "etapas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ordem",
                "acao",
                "prazo_minutos",
                "codigos_tuss"
              ],
              "properties": {
                "ordem": {
                  "type": "integer"
                },
                "acao": {
                  "type": "string"
                },
                "prazo_minutos": {
                  "type": "integer"
                },
                "codigos_tuss": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "prescricao_padrao": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dcb",
                "dose",
                "via",
                "frequencia"
              ],
              "properties": {
                "dcb": {
                  "type": "string"
                },
                "dose": {
                  "type": "string"
                },
                "via": {
                  "type": "string"
                },
                "frequencia": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "prontuarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "prontuario_id",
          "paciente",
          "atendimentos"
        ],
        "properties": {
          "prontuario_id": {
            "type": "string"
          },
          "paciente": {
            "type": "object",
            "required": [
              "id",
              "nome_completo",
              "cpf_mascarado",
              "cns",
              "data_nascimento",
              "idade",
              "sexo_biologico",
              "tipo_sanguineo",
              "alergias",
              "comorbidades_previas"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "nome_completo": {
                "type": "string"
              },
              "cpf_mascarado": {
                "type": "string"
              },
              "cns": {
                "type": "string"
              },
              "data_nascimento": {
                "type": "string",
                "format": "date"
              },
              "idade": {
                "type": "integer"
              },
              "sexo_biologico": {
                "type": "string",
                "enum": [
                  "M",
                  "F"
                ]
              },
              "tipo_sanguineo": {
                "type": "string"
              },
              "alergias": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "comorbidades_previas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "atendimentos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "atendimento_id",
                "data_entrada",
                "status",
                "classificacao_manchester",
                "protocolo_aplicado_id",
                "profissional_responsavel",
                "triagem_sinais_vitais",
                "evolucao_soap",
                "exames_solicitados",
                "prescricoes_ativas"
              ],
              "properties": {
                "atendimento_id": {
                  "type": "string"
                },
                "data_entrada": {
                  "type": "string",
                  "format": "date-time"
                },
                "data_alta": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "status": {
                  "type": "string"
                },
                "classificacao_manchester": {
                  "type": "string"
                },
                "protocolo_aplicado_id": {
                  "type": "string"
                },
                "profissional_responsavel": {
                  "type": "object",
                  "required": [
                    "nome",
                    "conselho",
                    "especialidade"
                  ],
                  "properties": {
                    "nome": {
                      "type": "string"
                    },
                    "conselho": {
                      "type": "string"
                    },
                    "especialidade": {
                      "type": "string"
                    }
                  }
                },
                "triagem_sinais_vitais": {
                  "type": "object",
                  "required": [
                    "pa_mmhg",
                    "fc_bpm",
                    "fr_irpm",
                    "temperatura_c",
                    "spo2_pct",
                    "glasgow",
                    "glicemia_mg_dl"
                  ],
                  "properties": {
                    "pa_mmhg": {
                      "type": "string"
                    },
                    "fc_bpm": {
                      "type": "integer"
                    },
                    "fr_irpm": {
                      "type": "integer"
                    },
                    "temperatura_c": {
                      "type": "number"
                    },
                    "spo2_pct": {
                      "type": "integer"
                    },
                    "glasgow": {
                      "type": "integer"
                    },
                    "glicemia_mg_dl": {
                      "type": "integer"
                    }
                  }
                },
                "evolucao_soap": {
                  "type": "object",
                  "required": [
                    "subjetivo",
                    "objetivo",
                    "avaliacao",
                    "plano"
                  ],
                  "properties": {
                    "subjetivo": {
                      "type": "string"
                    },
                    "objetivo": {
                      "type": "string"
                    },
                    "avaliacao": {
                      "type": "string"
                    },
                    "plano": {
                      "type": "string"
                    }
                  }
                },
                "exames_solicitados": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "tuss",
                      "nome",
                      "resultado",
                      "status"
                    ],
                    "properties": {
                      "tuss": {
                        "type": "string"
                      },
                      "nome": {
                        "type": "string"
                      },
                      "resultado": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      }
                    }
                  }
                },
                "prescricoes_ativas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "medicamento",
                      "via",
                      "posologia",
                      "horario_administracao"
                    ],
                    "properties": {
                      "medicamento": {
                        "type": "string"
                      },
                      "via": {
                        "type": "string"
                      },
                      "posologia": {
                        "type": "string"
                      },
                      "horario_administracao": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}