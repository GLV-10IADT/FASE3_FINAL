{"id": "hospital_faq:FAQ_CG_003", "question": "O Clínico Geral fornece encaminhamento para especialistas?", "answer": "Sim. Durante a consulta, o Clínico Geral avalia o seu quadro completo e, caso seja necessário um acompanhamento específico (como cardiologista, endocrinologista ou dermatologista), emite o encaminhamento médico detalhado.", "source_dataset": "hospital_faq", "source_id": "FAQ_CG_003", "license": null, "license_note": "corpos oficial registro 999/2026", "source_group_id": "FAQ_CG_003", "source_url": null, "context": null, "label": null, "source_subset": null, "label_provenance": null, "evaluation_eligible": false, "split": "test", "question_type": null, "focus": null, "source_origin": null, "review_status": "approved", "source_version": "sha256:b429bf81a25c37e6a66518a5f6999a5aaff584413e2ed89aabc40573f2353563", "source_metadata": {"especialidade": "Clínica Geral", "categoria": "faq", "tags": ["encaminhamento", "especialista", "guia"]}, "usage_rights_reference": "corpos oficial registro 999/2026", "institutional_approval_status": "approved", "institutional_approval_reference": "999", "institutional_approved_at": "2026-05-26", "privacy_review_status": "approved", "privacy_review_reference": "999", "privacy_reviewed_at": "2026-05-31", "contains_patient_data": false, "preprocessing_version": "local-regex-v2", "preprocessing_redaction_counts": {"email": 0, "cpf": 0, "phone": 0, "medical_record_id": 0, "hospital_document_id": 0, "date_of_birth": 0, "postal_code": 0}, "preprocessing_review_required": false}
{"id": "hospital_faq:FAQ_CG_004", "question": "Vocês renovam receitas de remédios controlados ou de uso contínuo?", "answer": "A renovação de receitas depende de avaliação médica para garantir a segurança do tratamento. Se você já é paciente da clínica e passou em consulta presencial nos últimos 6 meses, podemos agendar uma teleconsulta de reavaliação. Para receitas azuis ou amarelas (notificação de receita), a retirada do documento físico na clínica é obrigatória conforme normas da Anvisa.", "source_dataset": "hospital_faq", "source_id": "FAQ_CG_004", "license": null, "license_note": "corpos oficial registro 999/2026", "source_group_id": "FAQ_CG_004", "source_url": null, "context": null, "label": null, "source_subset": null, "label_provenance": null, "evaluation_eligible": false, "split": "test", "question_type": null, "focus": null, "source_origin": null, "review_status": "approved", "source_version": "sha256:b429bf81a25c37e6a66518a5f6999a5aaff584413e2ed89aabc40573f2353563", "source_metadata": {"especialidade": "Clínica Geral", "categoria": "faq", "tags": ["receita", "medicamento", "uso_continuo", "controlado", "anvisa"]}, "usage_rights_reference": "corpos oficial registro 999/2026", "institutional_approval_status": "approved", "institutional_approval_reference": "999", "institutional_approved_at": "2026-05-26", "privacy_review_status": "approved", "privacy_review_reference": "999", "privacy_reviewed_at": "2026-05-31", "contains_patient_data": false, "preprocessing_version": "local-regex-v2", "preprocessing_redaction_counts": {"email": 0, "cpf": 0, "phone": 0, "medical_record_id": 0, "hospital_document_id": 0, "date_of_birth": 0, "postal_code": 0}, "preprocessing_review_required": false}
